# ── Supabase PostgreSQL ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# SERVER-ONLY. Never prefix this NEXT_PUBLIC_ — that would inline it into the
# browser bundle and hand every visitor full database access.
# All Supabase access in this app is server-side, so the service role is safe
# here and is what lets RLS deny the anon role outright (migration 002).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kept only for backwards compatibility during the cutover. Once migration 002
# is applied this key can do nothing, and it should be rotated because the old
# value was public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Admin passcode for /admin ───────────────────────────────────
# Use a long random value, not a guessable phrase. Anyone with this can read
# and modify every team record.
ADMIN_SECRET_KEY=replace-with-a-long-random-secret

# ── Cron authorisation ──────────────────────────────────────────
# Required (min 16 chars) or /api/cron/payment-reminders stays disabled. Vercel
# Cron sends this automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=replace-with-a-long-random-secret

# ── Public site origin (used in email links) ────────────────────
# Must be the real deployed origin — email links and the List-Unsubscribe
# header are built from it.
NEXT_PUBLIC_SITE_URL=https://orion-10-nine.vercel.app

# ── Official WhatsApp group link ────────────────────────────────
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/orion1point0

# ── SMTP / transactional email (nodemailer) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# EMAIL_FROM must be on the SAME domain as SMTP_USER. A From: address the SMTP
# account cannot authenticate for fails DMARC alignment and lands in spam; the
# mailer detects a mismatch, warns, and falls back to SMTP_USER.
EMAIL_FROM=your-address@gmail.com
EMAIL_FROM_NAME=ORION 1.0 Secretariat
EMAIL_REPLY_TO=your-address@gmail.com
